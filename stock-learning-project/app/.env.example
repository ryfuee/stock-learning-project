HOST=0.0.0.0
PORT=4173
A_SHARE_RUNTIME_DIR=

# Optional login bootstrap. If omitted, the first browser visit will ask you to create the admin account.
# Passwords are stored as PBKDF2 hashes in the local SQLite database under A_SHARE_RUNTIME_DIR.
A_SHARE_ADMIN_USER=
A_SHARE_ADMIN_PASSWORD=
A_SHARE_SESSION_DAYS=14
# Set to 1 only when the site is served through HTTPS.
A_SHARE_COOKIE_SECURE=

# Optional custom A-share watchlist. You can also configure it on the page.
# Format examples: "600519 贵州茅台 白酒; 300750 宁德时代 电池" or "600519,300750,002475"
STOCK_LIST=
PYTHON_BIN=python3

# Optional fundamental data providers.
# AKShare and Baostock do not require API keys, but the Python packages must be installed on the server.
# Tushare is optional and only used when enabled in the app config.
TUSHARE_TOKEN=

# Optional real-time event/news search providers.
# Configure one or more; the app skips providers without a key and never mocks search results.
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
ANSPIRE_API_KEY=

# Optional strategy optimizer behavior.
# Default empty means "generate recommendations only". Set to 1 only if you want bounded paper-trading config updates.
A_SHARE_AUTO_APPLY_OPTIMIZER=

# Discord webhook is intentionally disabled by default.
# Do not commit a real webhook URL.
DISCORD_WEBHOOK_URL=

# Optional LLM decision layer.
# ChatGPT Pro/Plus subscriptions are separate from API billing.
# Keep API keys on the server; do not commit real secrets.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional provider-specific fallbacks.
OPENAI_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
ARK_API_KEY=
